      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.04z17lu1j8e2ux1aybmzc01pb02a].[sum:Children apprehended and placed in CBP custody*:qk]&quot;' value='Children Considered for CBP custody' />
          <alias key='&quot;[federated.04z17lu1j8e2ux1aybmzc01pb02a].[sum:Children transferred out of CBP custody:qk]&quot;' value='Children transferred from CBP to HHS care' />
        </aliases>
      </column>
      <column caption='Max Value' datatype='real' name='[Calculation_10280747644002305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Children apprehended and placed in CBP custody*]&gt;[Children in CBP custody] and [Children apprehended and placed in CBP custody*] &gt; [Children transferred out of CBP custody] &#13;&#10;then [Children apprehended and placed in CBP custody*] &#13;&#10;ELSEIF [Children in CBP custody]&gt;[Children apprehended and placed in CBP custody*] and [Children in CBP custody]&gt;[Children transferred out of CBP custody] &#13;&#10;then [Children in CBP custody]&#13;&#10;else [Children transferred out of CBP custody] &#13;&#10;END' />
      </column>
      <column caption='Avg Value' datatype='real' name='[Calculation_1128138353197056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Children apprehended and placed in CBP custody*]+[Children in CBP custody]+[Children transferred out of CBP custody])/3' />
      </column>
